rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidServerTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.calorieGoal is int && data.calorieGoal >= 800 && data.calorieGoal <= 8000 &&
             data.proteinGoalG is int && data.proteinGoalG >= 10 && data.proteinGoalG <= 600 &&
             data.carbsGoalG is int && data.carbsGoalG >= 10 && data.carbsGoalG <= 1000 &&
             data.fatGoalG is int && data.fatGoalG >= 10 && data.fatGoalG <= 400 &&
             data.waterGoalMl is int && data.waterGoalMl >= 500 && data.waterGoalMl <= 8000 &&
             data.currentWeightKg is number && data.currentWeightKg >= 20.0 && data.currentWeightKg <= 350.0 &&
             data.targetWeightKg is number && data.targetWeightKg >= 20.0 && data.targetWeightKg <= 350.0 &&
             data.heightCm is number && data.heightCm >= 80.0 && data.heightCm <= 260.0 &&
             data.age is int && data.age >= 13 && data.age <= 120 &&
             data.sex in ['male', 'female'] &&
             data.activityLevel in ['sedentary', 'light', 'moderate', 'active', 'athlete'] &&
             data.goalType in ['lose', 'maintain', 'gain'] &&
             data.useMetricUnits is bool &&
             data.onboardingDone is bool;
    }

    function isValidMealEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             isValidDateKey(data.dateKey) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.mealType in ['breakfast', 'lunch', 'dinner', 'snack'] &&
             data.calories is int && data.calories >= 0 && data.calories <= 10000 &&
             data.proteinG is int && data.proteinG >= 0 && data.proteinG <= 1000 &&
             data.carbsG is int && data.carbsG >= 0 && data.carbsG <= 1500 &&
             data.fatG is int && data.fatG >= 0 && data.fatG <= 1000 &&
             data.fiberG is int && data.fiberG >= 0 && data.fiberG <= 500 &&
             data.healthScore is int && data.healthScore >= 1 && data.healthScore <= 10 &&
             data.servingMultiplier is number && data.servingMultiplier >= 0.1 && data.servingMultiplier <= 10.0 &&
             data.inputSource in ['photo', 'text', 'manual'] &&
             data.aiNotes is string && data.aiNotes.size() <= 400 &&
             data.ingredients is list && data.ingredients.size() <= 20 &&
             (data.ingredients.size() == 0 || (data.ingredients[0] is string && data.ingredients[0].size() <= 140)) &&
             data.loggedAtEpochMs is int && data.loggedAtEpochMs >= 0;
    }

    function isValidDailyWaterLog(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.waterMl is int && data.waterMl >= 0 && data.waterMl <= 15000;
    }

    function isValidWeightEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.weightKg is number && data.weightKg >= 20.0 && data.weightKg <= 350.0 &&
             isValidDateKey(data.dateKey) &&
             data.note is string && data.note.size() <= 200 &&
             data.recordedAtEpochMs is int && data.recordedAtEpochMs >= 0;
    }

    // --- User-Scoped Subcollections ---
    match /users/{userId} {
      // Profile & Goals (/users/{userId}/profile/goals)
      match /profile/{profileId} {
        allow get: if isOwner(userId) && profileId == 'goals';
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         profileId == 'goals' &&
                         incoming().keys().hasAll([
                           'userId', 'displayName', 'calorieGoal', 'proteinGoalG', 'carbsGoalG',
                           'fatGoalG', 'waterGoalMl', 'currentWeightKg', 'targetWeightKg',
                           'heightCm', 'age', 'sex', 'activityLevel', 'goalType',
                           'useMetricUnits', 'onboardingDone', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'displayName', 'calorieGoal', 'proteinGoalG', 'carbsGoalG',
                           'fatGoalG', 'waterGoalMl', 'currentWeightKg', 'targetWeightKg',
                           'heightCm', 'age', 'sex', 'activityLevel', 'goalType',
                           'useMetricUnits', 'onboardingDone', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidUserProfile(incoming()) &&
                         isValidServerTimestamp(incoming().createdAt) &&
                         isValidServerTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         profileId == 'goals' &&
                         isValidUserProfile(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidServerTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'calorieGoal', 'proteinGoalG', 'carbsGoalG',
                           'fatGoalG', 'waterGoalMl', 'currentWeightKg', 'targetWeightKg',
                           'heightCm', 'age', 'sex', 'activityLevel', 'goalType',
                           'useMetricUnits', 'onboardingDone', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && profileId == 'goals';
      }

      // Meals (/users/{userId}/meals/{mealId})
      match /meals/{mealId} {
        allow get: if isOwner(userId) && isValidId(mealId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(mealId) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'name', 'mealType', 'calories',
                           'proteinG', 'carbsG', 'fatG', 'fiberG', 'healthScore',
                           'servingMultiplier', 'inputSource', 'aiNotes', 'ingredients',
                           'loggedAtEpochMs', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'name', 'mealType', 'calories',
                           'proteinG', 'carbsG', 'fatG', 'fiberG', 'healthScore',
                           'servingMultiplier', 'inputSource', 'aiNotes', 'ingredients',
                           'loggedAtEpochMs', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMealEntry(incoming()) &&
                         isValidServerTimestamp(incoming().createdAt) &&
                         isValidServerTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         isValidId(mealId) &&
                         isValidMealEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidServerTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'mealType', 'calories', 'proteinG', 'carbsG',
                           'fatG', 'fiberG', 'healthScore', 'servingMultiplier',
                           'aiNotes', 'ingredients', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      // Daily Hydration Logs (/users/{userId}/dailyLogs/{dateKey})
      match /dailyLogs/{dateKey} {
        allow get: if isOwner(userId) && isValidDateKey(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         incoming().keys().hasAll(['userId', 'waterMl', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'waterMl', 'createdAt', 'updatedAt']) &&
                         isValidDailyWaterLog(incoming()) &&
                         isValidServerTimestamp(incoming().createdAt) &&
                         isValidServerTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         isValidDailyWaterLog(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidServerTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['waterMl', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidDateKey(dateKey);
      }

      // Weight Check-Ins (/users/{userId}/weights/{weightId})
      match /weights/{weightId} {
        allow get: if isOwner(userId) && isValidId(weightId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(weightId) &&
                         incoming().keys().hasAll([
                           'userId', 'weightKg', 'dateKey', 'note', 'recordedAtEpochMs', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'weightKg', 'dateKey', 'note', 'recordedAtEpochMs', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidWeightEntry(incoming()) &&
                         isValidServerTimestamp(incoming().createdAt) &&
                         isValidServerTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         isValidId(weightId) &&
                         isValidWeightEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidServerTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['weightKg', 'note', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(weightId);
      }
    }
  }
}
